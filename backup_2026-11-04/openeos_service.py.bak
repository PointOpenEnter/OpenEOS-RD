        self.progress_canvas.bind("<Configure>", self.redraw_progress)

        self.batch_progress_label = tk.Label(
            progress_inner, text="Ожидает запуска.", bg=self.CARD,
            fg=self.MUTED, anchor="w", font=(self.FONT_FAMILY, 8)
        )
        self.batch_progress_label.pack(fill="x", pady=(2, 1))

        self.batch_summary = tk.Label(
            progress_inner, text="Результатов пока нет.", bg=self.CARD,
            fg=self.MUTED, anchor="w", font=(self.FONT_FAMILY, 8, "bold")
        )
        self.batch_summary.pack(fill="x")

        table_card = tk.Frame(
            page, bg=self.CARD, highlightbackground=self.BORDER,
            highlightthickness=1, bd=0
        )
        table_card.pack(fill="both", expand=True)

        table_inner = tk.Frame(table_card, bg=self.CARD)
        table_inner.pack(fill="both", expand=True, padx=4, pady=4)

        columns = ("filename", "shutter", "date", "model", "observations", "path")
        self.batch_table = ttk.Treeview(
            table_inner, columns=columns, show="headings"
        )
        headings = {
            "filename": "Файл", "shutter": "ShutterCount",
            "date": "Дата съёмки", "model": "Камера",
            "observations": "Примечания", "path": "Полный путь"
        }
        widths = {
            "filename": 160, "shutter": 110, "date": 160,
            "model": 130, "observations": 180, "path": 340
        }
        for col in columns:
            self.batch_table.heading(
                col, text=headings[col],
                command=lambda column=col: self.sort_batch_table(column, False)
            )
            self.batch_table.column(
                col, width=widths[col], anchor="center" if col in ("shutter", "date") else "w"
            )

        scroll_y = ttk.Scrollbar(
            table_inner, orient="vertical", command=self.batch_table.yview,
            style="Vertical.TScrollbar"
        )
        scroll_x = ttk.Scrollbar(
            table_inner, orient="horizontal", command=self.batch_table.xview,
            style="Horizontal.TScrollbar"
        )
        self.batch_table.configure(yscrollcommand=scroll_y.set, xscrollcommand=scroll_x.set)

        self.batch_table.grid(row=0, column=0, sticky="nsew")
        scroll_y.grid(row=0, column=1, sticky="ns")
        scroll_x.grid(row=1, column=0, sticky="ew")

        table_inner.rowconfigure(0, weight=1)
        table_inner.columncase = False
        table_inner.columnconfigure(0, weight=1)

    def redraw_progress(self, _event=None) -> None:
        width = self.progress_canvas.winfo_width()
        current = getattr(self, "progress_ratio", 0.0)
        self.progress_canvas.coords(self.progress_fill, 0, 0, int(width * current), 8)

    def set_progress(self, current: int, total: int) -> None:
        ratio = current / total if total > 0 else 0.0
        self.progress_ratio = max(0.0, min(1.0, ratio))
        self.progress_percent.config(text=f"{int(self.progress_ratio * 100)}%")
        self.redraw_progress()

    def set_folder_path(self, folder: str) -> None:
        self.batch_folder_path = folder
        self.folder_text.set(self.compact_text(folder, 80))
        self.batch_summary.config(text="Папка выбрана. Нажмите «Анализировать папку».")
        self.batch_progress_label.config(text="Готово к запуску.")
        self.csv_button.config(state="disabled")

    def select_batch_folder(self) -> None:
        if self.busy:
            return
        folder = filedialog.askdirectory(title="Выберите папку с RAW-файлами")
        if folder:
            self.set_folder_path(folder)

    def analyze_batch(self) -> None:
        folder = self.batch_folder_path
        if not folder or not os.path.isdir(folder):
            messagebox.showwarning("OpenEOS", "Сначала выберите папку.")
            return
        if self.busy:
            return
        if not self.check_exiftool(show_message=True):
            return

        self.batch_cancel_event = threading.Event()
        self.batch_results = []
        self.batch_metadata = {}
        self.batch_total = 0
        self.batch_processed = 0
        self.batch_started_at = time.monotonic()
        self.batch_cancelled = False
        self.set_busy(True, "batch")
        self.set_progress(0, 0)
        self.batch_progress_label.config(text="Поиск файлов в папке…")
        self.batch_summary.config(text="Подготовка списка файлов.")
        threading.Thread(
            target=self.batch_worker, args=(folder,), daemon=True
        ).start()

    def batch_worker(self, folder: str) -> None:
        started = time.monotonic()
        results: list[dict] = []
        warnings: list[str] = []
        warnings_lock = threading.Lock()
        files: list[str] = []
        attempted = 0
        cancelled = False
        error_message: str | None = None
        process: subprocess.Popen | None = None
        stderr_thread: threading.Thread | None = None

        def drain_stderr(stderr_pipe):
            try:
                for line in stderr_pipe:
                    line = line.strip()
                    if line:
                        with warnings_lock:
                            warnings.append(line)
                            if len(warnings) > 100:
                                del warnings[:-100]
            except (OSError, ValueError):
                pass

        try:
            with os.scandir(folder) as entries:
                for index, entry in enumerate(entries, start=1):
                    if self.batch_cancel_event.is_set():
                        cancelled = True
                        break
                    try:
                        if entry.is_file(follow_symlinks=False):
                            ext = os.path.splitext(entry.name)[1].lower()
                            if ext in SUPPORTED_EXTENSIONS:
                                files.append(entry.path)
                    except OSError:
                        continue
                    if index % 200 == 0:
                        self.root.after(0, self.update_batch_discovery, len(files), False)

            if not cancelled:
                self.root.after(0, self.update_batch_discovery, len(files), True)
            files.sort(key=lambda path: os.path.basename(path).lower())
            total = len(files)

            if total == 0 or cancelled:
                cancelled = True
            else:
                creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
                command = [
                    *EXIFTOOL_CMD,
                    "-stay_open", "True", "-@", "-",
                    "-common_args", "-charset", "filename=utf8",
                    "-fast2", "-q", "-q", "-m"
                ]
                process = subprocess.Popen(
                    command,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    encoding="utf-8",
                    errors="replace",
                    bufsize=1,
                    creationflags=creationflags,
                    env=EXIFTOOL_ENV,
                    cwd=EXIFTOOL_CWD,
                )
                with self.batch_process_lock:
                    self.batch_process = process

                if process.stderr:
                    stderr_thread = threading.Thread(
                        target=drain_stderr, args=(process.stderr,), daemon=True
                    )
                    stderr_thread.start()

                chunk_size = BATCH_CHUNK_SIZE
                ready_marker = "{ready}"

                for start_idx in range(0, total, chunk_size):
                    if self.batch_cancel_event.is_set():
                        cancelled = True
                        break
                    chunk = files[start_idx:start_idx + chunk_size]

                    request_lines = ["-json\n"]
                    for tag in (
                        "-ShutterCount", "-Track4:ShutterCount", "-Canon:ShutterCount",
                        "-Nikon:ShutterCount", "-Sony:ShutterCount", "-Fuji:ShutterCount",
                        "-Model", "-DateTimeOriginal", "-FileName", "-Directory"
                    ):
                        request_lines.append(f"{tag}\n")
                    for file_path in chunk:
                        request_lines.append(f"{file_path}\n")
                    request_lines.append("-execute\n")

                    try:
                        process.stdin.write("".join(request_lines))
                        process.stdin.flush()
                    except (BrokenPipeError, OSError) as write_err:
                        raise RuntimeError(f"Сбой отправки блока в ExifTool: {write_err}")

                    output_lines = []
                    while True:
                        line = process.stdout.readline()
                        if line == "":
                            if self.batch_cancel_event.is_set():
                                cancelled = True
                                break
                            raise RuntimeError("ExifTool завершился до окончания блока.")
                        if line.strip() == ready_marker:
                            break
                        output_lines.append(line)

                    if cancelled or self.batch_cancel_event.is_set():
                        cancelled = True
                        break

                    output_text = "".join(output_lines).strip()
                    records = json.loads(output_text) if output_text else []
                    normalised_chunk = [
                        self.normalise_record(record, record.get("SourceFile", ""))
                        for record in records
                    ]
                    results.extend(normalised_chunk)
                    attempted += len(chunk)

                    elapsed = max(time.monotonic() - started, 0.001)
                    speed = attempted / elapsed
                    remaining = (total - attempted) / speed if speed > 0 else None
                    self.root.after(
                        0, self.update_batch_progress,
                        attempted, total, speed, remaining,
                        os.path.basename(chunk[-1])
                    )

            cancelled = cancelled or self.batch_cancel_event.is_set()

        except Exception as exc:
            error_message = str(exc)

        finally:
            if process is not None:
                try:
                    if process.poll() is None and not cancelled and not error_message:
                        if process.stdin and not process.stdin.closed:
                            process.stdin.write("-stay_open\nFalse\n")
                            process.stdin.flush()
                            process.stdin.close()
                        process.wait(timeout=15)
                    elif process.poll() is None:
                        process.terminate()
                        try:
                            process.wait(timeout=3)
                        except subprocess.TimeoutExpired:
                            process.kill()
                            process.wait(timeout=3)
                except (OSError, subprocess.TimeoutExpired):
                    try:
                        process.kill()
                    except OSError:
                        pass
                with self.batch_process_lock:
                    self.batch_process = None

            read_seconds = max(time.monotonic() - started, 0.001)
            metadata = {
                "folder": folder,
                "files_found": len(files),
                "files_attempted": attempted,
                "read_seconds": read_seconds,
                "average_files_per_second": (attempted / read_seconds) if read_seconds > 0 else 0,
                "cancelled": cancelled,
                "analysis_time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "exiftool_version": self.get_exiftool_version(),
            }
            self.root.after(0, self.finish_batch, results, metadata, cancelled, error_message)

    def update_batch_discovery(self, count: int, finished: bool) -> None:
        if finished:
            self.batch_progress_label.config(text=f"Найдено поддерживаемых файлов: {count:,}".replace(",", " "))
        else:
            self.batch_progress_label.config(text=f"Поиск файлов… найдено: {count:,}".replace(",", " "))

    def update_batch_progress(self, current: int, total: int, speed: float, remaining: float | None, current_file: str) -> None:
        self.set_progress(current, total)
        rem_str = f"~{int(remaining)} с" if remaining is not None and remaining >= 0 else "—"
        cur_file_short = self.compact_text(current_file, 28)
        self.batch_progress_label.config(
            text=f"Обработано {current:,} из {total:,}  ·  Скорость: {speed:.1f} ф/с  ·  Осталось: {rem_str}  ·  {cur_file_short}".replace(",", " ")
        )

    def finish_batch(self, results: list[dict], metadata: dict, cancelled: bool, error_message: str | None) -> None:
        self.set_busy(False)
        self.batch_results = results
        self.batch_metadata = metadata
        self.batch_cancelled = cancelled

        if error_message:
            self.show_error(error_message)
            self.batch_summary.config(text="Анализ прерван из-за ошибки.")
            return

        total_files = metadata.get("files_attempted", len(results))
        read_seconds = metadata.get("read_seconds", 0)
        readable_count = sum(1 for item in results if item.get("ShutterCount") is not None)
        missing_count = len(results) - readable_count

        if cancelled:
            summary_text = (
                f"Анализ прерван пользователем. Проверено: {total_files} файлов за {read_seconds:.1f} с. "
                f"Счётчик найден у {readable_count}, не найден у {missing_count}."
            )
        else:
            summary_text = (
                f"Готово. Проверено: {total_files:,} файлов за {read_seconds:.1f} с. "
                f"Счётчик найден: {readable_count:,}, не найден: {missing_count:,}."
            ).replace(",", " ")

        self.batch_summary.config(text=summary_text)
        self.batch_progress_label.config(text="Отображение результатов в таблице…")
        self.csv_button.config(state="normal" if results else "disabled")
        self.start_table_render()

    def start_table_render(self) -> None:
        for item in self.batch_table.get_children():
            self.batch_table.delete(item)
        self.render_index = 0
        self.render_chunk()

    def render_chunk(self) -> None:
        results = self.batch_results
        total = len(results)
        end = min(self.render_index + TABLE_CHUNK_SIZE, total)

        for i in range(self.render_index, end):
            data = results[i]
            shutter = data.get("ShutterCount")
            shutter_text = f"{int(shutter):,}".replace(",", " ") if shutter is not None else "Не найден"
            date_text = format_display_date(data.get("DateTimeOriginal"))
            obs = data.get("ProcessingError") or ("Счётчик найден" if shutter is not None else "Тег не записан")
            self.batch_table.insert(
                "", "end",
                values=(
                    data.get("FileName") or "",
                    shutter_text,
                    date_text,
                    data.get("Model") or "—",
                    obs,
                    data.get("SourceFile") or "",
                ),
            )
        self.render_index = end
        if self.render_index < total:
            self.root.after(10, self.render_chunk)
        else:
            readable = sum(1 for x in results if x.get("ShutterCount") is not None)
            missing = total - readable
            self.batch_progress_label.config(
                text=f"Таблица заполнена. Всего записей: {total:,} (со счётчиком: {readable:,}, без: {missing:,}).".replace(",", " ")
            )

    def cancel_batch(self) -> None:
        if not self.busy or self.current_mode != "batch":
            return
        self.batch_cancel_event.set()
        self.cancel_button.config(state="disabled", text="Останавливаем…")
        with self.batch_process_lock:
            if self.batch_process and self.batch_process.poll() is None:
                try:
                    self.batch_process.terminate()
                except OSError:
                    pass

    def sort_batch_table(self, col: str, reverse: bool) -> None:
        children = list(self.batch_table.get_children(""))
        if not children:
            return

        def sort_key(item_id):
            val = self.batch_table.set(item_id, col)
            if col == "shutter":
                clean = re.sub(r"[^\d]", "", val)
                return (0, int(clean)) if clean else (1, -1)
            return (0, val.lower())

        children.sort(key=sort_key, reverse=reverse)
        for index, item_id in enumerate(children):
            self.batch_table.move(item_id, "", index)
        self.batch_table.heading(
            col, command=lambda: self.sort_batch_table(col, not reverse)
        )

    @staticmethod
    def get_exiftool_version() -> str:
        try:
            creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            result = subprocess.run(
                [*EXIFTOOL_CMD, "-ver"], capture_output=True, text=True,
                encoding="utf-8", errors="replace", creationflags=creationflags,
                env=EXIFTOOL_ENV, cwd=EXIFTOOL_CWD,
            )
            return result.stdout.strip() if result.returncode == 0 else "Не удалось определить"
        except OSError:
            return "Не удалось определить"

    def export_csv(self) -> None:
        if self.busy:
            return
        if not self.batch_results:
            messagebox.showwarning("OpenEOS", "Сначала выполните пакетный анализ.")
            return
        path = filedialog.asksaveasfilename(
            title="Сохранить результаты", defaultextension=".csv",
            filetypes=[("CSV", "*.csv")]
        )
        if not path:
            return
        try:
            with open(path, "w", newline="", encoding="utf-8-sig") as file:
                writer = csv.writer(file)
                writer.writerow(["OpenEOS_version", APP_VERSION])
                writer.writerow(["ExifTool_version", self.batch_metadata.get("exiftool_version", "")])
                writer.writerow(["Analysis_time", self.batch_metadata.get("analysis_time", "")])
                writer.writerow(["Files_found", self.batch_metadata.get("files_found", "")])
                writer.writerow(["Files_attempted", self.batch_metadata.get("files_attempted", "")])
                writer.writerow(["Read_time_seconds", round(self.batch_metadata.get("read_seconds", 0), 2)])
                writer.writerow(["Average_files_per_second", round(self.batch_metadata.get("average_files_per_second", 0), 2)])
                writer.writerow(["Cancelled_by_user", bool(self.batch_metadata.get("cancelled", False))])
                writer.writerow([])
                writer.writerow([
                    "filename", "shutter_count", "counter_tag", "date_time_original",
                    "model", "directory", "full_path", "processing_error", "source"
                ])
                for data in self.batch_results:
                    writer.writerow([
                        data.get("FileName", ""), data.get("ShutterCount", ""),
                        data.get("CounterTag", ""), data.get("DateTimeOriginal", ""),
                        data.get("Model", ""), data.get("Directory", ""),
                        data.get("SourceFile", ""), data.get("ProcessingError", ""),
                        "ExifTool"
                    ])
            messagebox.showinfo("OpenEOS", "CSV сохранён.")
        except Exception as exc:
            self.show_error(str(exc))

    def set_busy(self, busy: bool, mode: str | None = None) -> None:
        self.busy = busy
        self.current_mode = mode if busy else None
        state = "disabled" if busy else "normal"
        self.single_select_button.config(state=state)
        self.batch_select_button.config(state=state)
        self.batch_analyze_button.config(state=state)
        self.csv_button.config(state="disabled" if busy or not self.batch_results else "normal")
        if busy and mode == "batch":
            self.cancel_button.config(state="normal", text="Прервать анализ")
        else:
            self.cancel_button.config(state="disabled", text="Прервать анализ")

    def show_error(self, error: str) -> None:
        messagebox.showerror("OpenEOS Service — ошибка", error)


if __name__ == "__main__":
    root = ROOT_CLASS()
    try:
        root.withdraw()
    except Exception:
        pass
    theme = detect_system_theme()
    bg = THEMES[theme]["BG"]
    root.configure(bg=bg)
    apply_titlebar_theme(root, theme == "dark")
    app = OpenEOSServiceApp(root)
    root.mainloop()

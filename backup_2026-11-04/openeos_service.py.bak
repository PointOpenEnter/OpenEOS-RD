def detect_system_theme() -> str:
    try:
        import winreg
        key = winreg.OpenKey(
            winreg.HKEY_CURRENT_USER,
            r"Software\Microsoft\Windows\CurrentVersion\Themes\Personalize"
        )
        for param in ("AppsUseLightTheme", "SystemUsesLightTheme"):
            try:
                val, _ = winreg.QueryValueEx(key, param)
                winreg.CloseKey(key)
                return "dark" if val == 0 else "light"
            except FileNotFoundError:
                continue
        winreg.CloseKey(key)
    except Exception:
        pass
    return "dark"


def apply_titlebar_theme(root: tk.Tk, dark: bool) -> None:
    try:
        hwnd = None
        try:
            frame = root.wm_frame()
            if frame:
                hwnd = int(frame, 16)
        except Exception:
            pass
        if not hwnd:
            hwnd = root.winfo_id()
        if not hwnd:
            return

        try:
            root_hwnd = ctypes.windll.user32.GetAncestor(ctypes.c_void_p(hwnd), ctypes.c_uint(2))
            if root_hwnd:
                hwnd = root_hwnd
        except Exception:
            pass

        DWMWA_USE_IMMERSIVE_DARK_MODE = 20
        val = ctypes.c_int(1 if dark else 0)
        res = ctypes.windll.dwmapi.DwmSetWindowAttribute(
            ctypes.c_void_p(hwnd),
            ctypes.c_uint(DWMWA_USE_IMMERSIVE_DARK_MODE),
            ctypes.byref(val),
            ctypes.sizeof(val)
        )
        if res != 0:
            ctypes.windll.dwmapi.DwmSetWindowAttribute(
                ctypes.c_void_p(hwnd),
                ctypes.c_uint(19),
                ctypes.byref(val),
                ctypes.sizeof(val)
            )
    except Exception:
        pass


def format_display_date(raw: str | None) -> str:
    if not raw or not isinstance(raw, str):
        return "—"
    val = raw.strip()
    parts = val.split(" ")
    if len(parts) == 2 and parts[0].count(":") == 2:
        ymd = parts[0].split(":")
        if len(ymd) == 3 and len(ymd[0]) == 4:
            return f"{ymd[2]}.{ymd[1]}.{ymd[0]}, {parts[1]}"
    return val



class InfoToolTip:
    def __init__(self, widget: tk.Widget, get_text_func, get_theme_func) -> None:
        self.widget = widget
        self.get_text_func = get_text_func
        self.get_theme_func = get_theme_func
        self.tip_window: tk.Toplevel | None = None
        self._show_job: str | None = None
        self._hide_job: str | None = None

        self.widget.bind("<Enter>", self.schedule_show)
        self.widget.bind("<Leave>", self.schedule_hide)
        self.widget.bind("<Button-1>", self.toggle_tip)

    def cancel_jobs(self) -> None:
        if self._show_job:
            try:
                self.widget.after_cancel(self._show_job)
            except Exception:
                pass
            self._show_job = None
        if self._hide_job:
            try:
                self.widget.after_cancel(self._hide_job)
            except Exception:
                pass
            self._hide_job = None

    def schedule_show(self, _event=None) -> None:
        self.cancel_jobs()
        if not self.tip_window:
            self._show_job = self.widget.after(300, self.show_tip)

    def schedule_hide(self, _event=None) -> None:
        self.cancel_jobs()
        if self.tip_window:
            self._hide_job = self.widget.after(160, self.hide_tip)

    def show_tip(self, _event=None) -> None:
        self.cancel_jobs()
        if self.tip_window:
            return
        text = self.get_text_func()
        if not text:
            return

        theme = self.get_theme_func()
        bg = "#1A1D22" if theme == "dark" else "#FFFFFF"
        fg = "#E6EDF3" if theme == "dark" else "#1F2328"
        border = "#38424D" if theme == "dark" else "#D0D7DE"
        accent = "#60CDFF" if theme == "dark" else "#0067C0"

        screen_w = self.widget.winfo_screenwidth()
        tip_w = 420
        x = self.widget.winfo_rootx() - 320
        if x + tip_w > screen_w - 20:
            x = screen_w - tip_w - 20
        if x < 20:
            x = 20
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 6

        self.tip_window = tw = tk.Toplevel(self.widget)
        tw.wm_overrideredirect(True)
        tw.wm_geometry(f"+{x}+{y}")
        tw.attributes("-topmost", True)

        box = tk.Frame(tw, bg=bg, highlightbackground=border, highlightthickness=1, padx=14, pady=10)
        box.pack(fill="both")
        box.bind("<Enter>", lambda _e: self.cancel_jobs())
        box.bind("<Leave>", lambda _e: self.schedule_hide())

        header = tk.Label(
            box, text="ℹ️  Справка: счётчик в файле и ресурс камеры",
            bg=bg, fg=accent, font=("Segoe UI", 9, "bold"), anchor="w"
        )
        header.pack(fill="x", pady=(0, 6))

        body = tk.Label(box, text=text, bg=bg, fg=fg, font=("Segoe UI", 8), justify="left", anchor="w")
        body.pack(fill="x")

    def hide_tip(self, _event=None) -> None:
        self.cancel_jobs()
        if self.tip_window:
            try:
                self.tip_window.destroy()
            except Exception:
                pass
            self.tip_window = None

    def toggle_tip(self, _event=None) -> None:
        self.cancel_jobs()
        if self.tip_window:
            self.hide_tip()
        else:
            self.show_tip()


class OpenEOSServiceApp:
    FONT_FAMILY = "Segoe UI"

    def __init__(self, root: tk.Tk) -> None:
        self.root = root
        try:
            self.root.withdraw()
        except Exception:
            pass

        self.theme_name = detect_system_theme()
        self.update_theme_attrs()

        self.root.configure(bg=self.BG)
        self.root.title(f"{APP_TITLE} — сервисная диагностика фотокамер")
        self.root.resizable(False, False)
        self.FONT_FAMILY = "Segoe UI"

        self.setup_window_geometry(860, 520)
        apply_titlebar_theme(self.root, self.theme_name == "dark")
        self.setup_app_icon()

        # Состояние приложения
        self.busy = False
        self.current_mode: str | None = None
        self.single_file: str | None = None
        self.last_single_data: dict | None = None
        self.batch_results: list[dict] = []
        self.batch_metadata: dict = {}
        self.batch_cancel_event = threading.Event()
        self.batch_process: subprocess.Popen | None = None
        self.batch_process_lock = threading.Lock()
        self.batch_folder_path: str | None = None
        self.batch_total = 0
        self.batch_processed = 0
        self.batch_started_at: float | None = None
        self.render_index = 0
        self.render_readable = 0
        self.render_missing = 0
        self.batch_cancelled = False
        self.current_tab_index = 0

        self.folder_text = tk.StringVar(value="Папка не выбрана")

        # Менеджер USB PTP сервиса
        self.ptp_mgr = CanonPTPManager()
        self.usb_connected = False
        self.usb_data: dict | None = None

        self.configure_styles()
        self.create_interface()

        apply_titlebar_theme(self.root, self.theme_name == "dark")
        self.root.update_idletasks()
        self.root.deiconify()
        apply_titlebar_theme(self.root, self.theme_name == "dark")

    def style_tooltip_button(self, widget: tk.Label) -> None:
        def on_enter(_e):
            widget.config(fg=self.ACCENT if self.theme_name == "light" else "#60CDFF")
        def on_leave(_e):
            widget.config(fg=self.MUTED)
        widget.bind("<Enter>", on_enter, add="+")
        widget.bind("<Leave>", on_leave, add="+")
        self.rating_info_tip = InfoToolTip(widget, self.get_tooltip_text, lambda: self.theme_name)

    def get_tooltip_text(self) -> str:
        model = self.single_meta.get("model")
        model_name = model.cget("text") if model else ""
        has_model = bool(model_name and model_name not in ("—", "Не определена"))
        rating = get_camera_rating(model_name) if has_model else None

        if rating:
            rating_str = f"~{rating:,} кадров".replace(",", " ")
            res_bullet = f"• Расчётный ресурс механики для {model_name}: {rating_str}."
        else:
            res_bullet = "• Паспортный ресурс производителя нормирует только механический узел шторок."

        return (
            "Счётчик в метаданных кадра (RAW / JPEG):\n"
            "• Фиксирует общее количество спусков во всех режимах съёмки, включая электронный затвор.\n\n"
            "Паспортный ресурс камеры:\n"
            f"{res_bullet}\n"
            "• Заявленный ресурс производителя относится исключительно к механическим шторкам.\n\n"
            "Практический вывод:\n"
            "• Съёмка с электронным затвором не расходует ресурс механического узла камеры."
        )

    def setup_app_icon(self) -> None:
        try:
            myappid = f"openeos.service.desktop.{APP_VERSION}"
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(myappid)
        except Exception:
            pass

        base_dir = getattr(sys, "_MEIPASS", os.path.dirname(os.path.abspath(__file__)))
        local_dir = os.path.dirname(os.path.abspath(sys.executable if getattr(sys, "frozen", False) else __file__))

        for folder in (base_dir, local_dir):
            if not folder or not os.path.isdir(folder):
                continue

            service_ico = os.path.join(folder, "app_icon_service.ico")
            if not os.path.isfile(service_ico):
                try:
                    import create_icons
                    create_icons.generate_all_icons(folder)
                except Exception:
                    pass

            for candidate in ("app_icon_service.ico", "app_icon.ico"):
                ico_path = os.path.join(folder, candidate)
                if os.path.isfile(ico_path):
                    try:
                        self.root.iconbitmap(ico_path)
                        break
                    except Exception:
                        pass

            for png_name in ("app_icon_service.png", "app_icon.png"):
                png_path = os.path.join(folder, png_name)
                if os.path.isfile(png_path):
                    try:
                        self.app_photo_icon = tk.PhotoImage(file=png_path)
                        self.root.iconphoto(True, self.app_photo_icon)
                        break
                    except Exception:
                        pass
            return

    def update_theme_attrs(self) -> None:
        palette = THEMES[self.theme_name]
        for k, v in palette.items():
            setattr(self, k, v)

    def setup_window_geometry(self, width: int, height: int) -> None:
        screen_w = self.root.winfo_screenwidth()
        screen_h = self.root.winfo_screenheight()
        w = min(width, screen_w - 40)
        h = min(height, screen_h - 80)
        x = max(0, (screen_w - w) // 2)
        y = max(0, (screen_h - h) // 2)
        self.root.geometry(f"{w}x{h}+{x}+{y}")
        self.root.resizable(False, False)

    def toggle_theme(self) -> None:
        if self.busy and self.current_mode == "batch":
            messagebox.showinfo("OpenEOS", "Смена темы недоступна во время пакетного анализа.")
            return

        self.theme_name = "dark" if self.theme_name == "light" else "light"
        self.update_theme_attrs()
        self.configure_styles()

        last_shutter_text = self.counter_label.cget("text")
        last_status_text = self.single_status_label.cget("text")
        last_file_label = self.selected_file_label.cget("text")
        last_meta = {k: v.cget("text") for k, v in self.single_meta.items()}
        active_tab = self.current_tab_index

        if hasattr(self, "rating_info_tip") and self.rating_info_tip:
            self.rating_info_tip.hide_tip()

        for child in self.root.winfo_children():
            child.destroy()

        self.create_interface()
        self.switch_tab(active_tab, initial=True)

        apply_titlebar_theme(self.root, self.theme_name == "dark")
        self.counter_label.config(text=last_shutter_text)
        if "Готово" in last_status_text or "Проверено" in last_status_text:
            self.set_single_status("●  Готово", self.STATUS_BG_OK, self.STATUS_FG_OK)
        elif "Ожидает" in last_status_text:
            self.set_single_status("●  Ожидает фото", self.STATUS_BG_IDLE, self.STATUS_FG_IDLE)
        elif "Не найден" in last_status_text:
            self.set_single_status("●  Счётчик не найден", self.STATUS_BG_WARN, self.STATUS_FG_WARN)
        elif "Ошибка" in last_status_text:
            self.set_single_status("✕  Ошибка", self.STATUS_BG_ERR, self.STATUS_FG_ERR)
        else:
            self.set_single_status(last_status_text, self.STATUS_BG_IDLE, self.STATUS_FG_IDLE)

        self.selected_file_label.config(text=last_file_label)
        for k, val in last_meta.items():
            if k in self.single_meta:
                self.single_meta[k].config(text=val)

        if self.batch_results:
            self.start_table_render()

    def style_button(self, btn: tk.Button, bg: str, hover_bg: str, fg: str, font: tuple | None = None) -> tk.Button:
        if font is None:
            font = (self.FONT_FAMILY, 9, "bold")
        btn.config(
            bg=bg, fg=fg,
            activebackground=hover_bg,
            activeforeground=fg,
            disabledforeground=self.SUBTLE,
            relief="flat", bd=0,
            font=font,
            cursor="hand2"
        )
        def on_enter(_event):
            if str(btn["state"]) != "disabled":
                btn.config(bg=hover_bg)
        def on_leave(_event):
            if str(btn["state"]) != "disabled":
                btn.config(bg=bg)
        btn.bind("<Enter>", on_enter)
        btn.bind("<Leave>", on_leave)
        return btn

    def configure_styles(self) -> None:
        style = ttk.Style(self.root)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        style.configure(
            "Treeview",
            background=self.CARD,
            fieldbackground=self.CARD,
            foreground=self.TEXT,
            rowheight=28,
            borderwidth=0,
            relief="flat",
            font=(self.FONT_FAMILY, 9),
        )
        style.configure(
            "Treeview.Heading",
            background=self.GRAY_BTN,
            foreground=self.MUTED,
            font=(self.FONT_FAMILY, 8, "bold"),
            relief="flat",
            borderwidth=0,
            padding=(8, 6),
        )
        style.map(
            "Treeview.Heading",
            background=[("active", self.BORDER)],
            foreground=[("active", self.TEXT)],
        )
        style.map(
            "Treeview",
            background=[("selected", self.ACCENT_BG)],
            foreground=[("selected", self.TEXT)],
        )

        for sbar_name in ("Vertical.TScrollbar", "Horizontal.TScrollbar"):
            style.configure(
                sbar_name,
                gripcount=0,
                background=self.SCROLL_THUMB,
                darkcolor=self.CARD,
                lightcolor=self.CARD,
                troughcolor=self.SCROLL_TROUGH,
                bordercolor=self.CARD,
                arrowcolor=self.MUTED,
                arrowsize=12,
            )
            style.map(
                sbar_name,
                background=[("active", self.MUTED), ("pressed", self.ACCENT)],
                arrowcolor=[("active", self.TEXT)],
            )

    @staticmethod
    def compact_text(value: str | None, limit: int = 70) -> str:
        text = str(value or "")
        if len(text) <= limit:
            return text
        keep = max(8, (limit - 1) // 2)
        return text[:keep] + "…" + text[-keep:]

    def create_interface(self) -> None:
        self.root.configure(bg=self.BG)

        # Верхняя панель: Название, подзаголовок, кнопка темы и версия
        header = tk.Frame(self.root, bg=self.BG)
        header.pack(fill="x", padx=24, pady=(12, 8))

        left_col = tk.Frame(header, bg=self.BG)
        left_col.pack(side="left", fill="y")

        # Фирменная зелёная иконка сервисной утилиты OpenEOS Service
        self.header_icon_label = None
        base_dir = getattr(sys, "_MEIPASS", os.path.dirname(os.path.abspath(__file__)))
        service_png = os.path.join(base_dir, "app_icon_service.png")
        if os.path.isfile(service_png):
            try:
                self.header_icon_img = tk.PhotoImage(file=service_png).subsample(9, 9)
                self.header_icon_label = tk.Label(left_col, image=self.header_icon_img, bg=self.BG)
                self.header_icon_label.pack(side="left", padx=(0, 10), anchor="center")
            except Exception:
                pass

        title_label = tk.Label(
            left_col, text=APP_TITLE, bg=self.BG, fg=self.TEXT,
            font=(self.FONT_FAMILY, 20, "bold")
        )
        title_label.pack(side="left", anchor="center")

        service_badge = tk.Label(
            left_col, text="SERVICE", bg="#16845B", fg="#FFFFFF",
            font=(self.FONT_FAMILY, 7, "bold"), padx=6, pady=2
        )
        service_badge.pack(side="left", padx=(8, 0), anchor="center")

        subtitle = tk.Label(
            left_col,
            text="Сервисная диагностика затвора и лога ошибок Canon",
            bg=self.BG, fg=self.MUTED, font=(self.FONT_FAMILY, 9)
        )
        subtitle.pack(side="left", padx=(10, 0), anchor="center")

        right_col = tk.Frame(header, bg=self.BG)
        right_col.pack(side="right", fill="y")

        theme_text = "🌙  Тёмная" if self.theme_name == "light" else "☀️  Светлая"
        self.theme_btn = tk.Button(
            right_col, text=theme_text, command=self.toggle_theme,
            font=(self.FONT_FAMILY, 8, "bold"), padx=10, pady=3
        )
        self.style_button(
            self.theme_btn,
            bg=self.BADGE_BG, hover_bg=self.GRAY_BTN_HOVER, fg=self.BADGE_FG
        )
        self.theme_btn.pack(side="left", padx=(0, 8))

        v_pill = tk.Label(
            right_col, text=f"v{APP_VERSION}", bg=self.BADGE_BG, fg=self.BADGE_FG,
            font=(self.FONT_FAMILY, 8, "bold"), padx=8, pady=3
        )
        v_pill.pack(side="left")

        # Сегментированные вкладки (3 вкладки!)
        self.tab_bar_frame = tk.Frame(self.root, bg=self.BG)
        self.tab_bar_frame.pack(fill="x", padx=24, pady=(0, 0))

        tabs_inner = tk.Frame(self.tab_bar_frame, bg=self.BG)
        tabs_inner.pack(side="left")

        self.tab_btn_1 = tk.Button(
            tabs_inner, text="Проверить фото", command=lambda: self.switch_tab(0),
            padx=18, pady=7, font=(self.FONT_FAMILY, 9, "bold"),
            bd=0, relief="flat", cursor="hand2"
        )
        self.tab_btn_1.pack(side="left", padx=(0, 6))

        self.tab_btn_2 = tk.Button(
            tabs_inner, text="Анализ папки", command=lambda: self.switch_tab(1),
            padx=18, pady=7, font=(self.FONT_FAMILY, 9, "bold"),
            bd=0, relief="flat", cursor="hand2"
        )
        self.tab_btn_2.pack(side="left", padx=(0, 6))

        self.tab_btn_3 = tk.Button(
            tabs_inner, text="🔌  Камера по USB", command=lambda: self.switch_tab(2),
            padx=18, pady=7, font=(self.FONT_FAMILY, 9, "bold"),
            bd=0, relief="flat", cursor="hand2"
        )
        self.tab_btn_3.pack(side="left")

        self.tab_baseline = tk.Frame(self.root, bg=self.BORDER, height=1)
        self.tab_baseline.pack(fill="x", padx=24, pady=(3, 6))

        self.tab_content = tk.Frame(self.root, bg=self.BG)
        self.tab_content.pack(fill="both", expand=True)

        self.single_tab = tk.Frame(self.tab_content, bg=self.BG)
        self.batch_tab = tk.Frame(self.tab_content, bg=self.BG)
        self.usb_tab = tk.Frame(self.tab_content, bg=self.BG)

        self.create_single_tab()
        self.create_batch_tab()
        self.create_usb_tab()

        self.switch_tab(2, initial=True)  # По умолчанию открываем вкладку USB!

        if DND_AVAILABLE:
            self.register_drop_targets(self.single_tab)
            self.register_drop_targets(self.batch_tab)

    def switch_tab(self, index: int, initial: bool = False) -> None:
        if self.busy and self.current_mode == "batch" and index != 1:
            messagebox.showinfo("OpenEOS", "Сначала дождитесь завершения операции или остановите анализ.")
            return

        self.current_tab_index = index

        # Скрываем все вкладки
        self.single_tab.pack_forget()
        self.batch_tab.pack_forget()
        self.usb_tab.pack_forget()

        # Сбрасываем стили кнопок
        for btn in (self.tab_btn_1, self.tab_btn_2, self.tab_btn_3):
            btn.config(
                bg=self.BG, fg=self.MUTED,
                activebackground=self.BG, activeforeground=self.TEXT,
                highlightthickness=0
            )

        if index == 0:
            self.single_tab.pack(fill="both", expand=True)
            self.tab_btn_1.config(
                bg=self.TAB_SEL_BG, fg=self.TAB_SEL_FG,
                activebackground=self.TAB_SEL_BG, activeforeground=self.TAB_SEL_FG,
                highlightthickness=1, highlightbackground=self.BORDER
            )
        elif index == 1:
            self.batch_tab.pack(fill="both", expand=True)
            self.tab_btn_2.config(
                bg=self.TAB_SEL_BG, fg=self.TAB_SEL_FG,
                activebackground=self.TAB_SEL_BG, activeforeground=self.TAB_SEL_FG,
                highlightthickness=1, highlightbackground=self.BORDER
            )
        else:
            self.usb_tab.pack(fill="both", expand=True)
            service_accent = "#16845B" if self.theme_name == "light" else "#34D399"
            self.tab_btn_3.config(
                bg=self.TAB_SEL_BG, fg=service_accent,
                activebackground=self.TAB_SEL_BG, activeforeground=service_accent,
                highlightthickness=1, highlightbackground=service_accent
            )

    # ---------------------------------------------------------------------------
    # Вкладка 3: Сервис USB (Прямое подключение)
    # ---------------------------------------------------------------------------
    def create_usb_tab(self) -> None:
        page = tk.Frame(self.usb_tab, bg=self.BG)
        page.pack(fill="both", expand=True, padx=24, pady=(2, 10))

        # 1. Верхняя панель управления подключением (Connection Bar)
        ctrl_card = tk.Frame(page, bg=self.CARD, highlightbackground=self.BORDER, highlightthickness=1, bd=0)
        ctrl_card.pack(fill="x", pady=(0, 8))

        ctrl_inner = tk.Frame(ctrl_card, bg=self.CARD)
        ctrl_inner.pack(fill="x", padx=14, pady=10)

        # Кнопка Подключить / Отключить
        self.usb_connect_btn = tk.Button(
            ctrl_inner, text="Подключить", command=self.toggle_usb_connect,
            padx=20, pady=7, font=(self.FONT_FAMILY, 9, "bold")
        )
        self.style_button(
            self.usb_connect_btn,
            bg="#16845B", hover_bg="#13734F", fg="#FFFFFF"
        )
        self.usb_connect_btn.pack(side="left", padx=(0, 10))

        # Кнопка Прочитать счётчики (PTP)
        self.usb_read_counters_btn = tk.Button(
            ctrl_inner, text="Прочитать счётчики", command=self.read_usb_counters,
            padx=18, pady=7, font=(self.FONT_FAMILY, 9, "bold"), state="disabled"
        )
        self.style_button(
            self.usb_read_counters_btn,
            bg=self.ACCENT, hover_bg=self.ACCENT_HOVER, fg="#FFFFFF"
        )
        self.usb_read_counters_btn.pack(side="left", padx=(0, 14))

        # Статус соединения
        self.usb_status_label = tk.Label(
            ctrl_inner, text="●  Камера не подключена (включите камеру и подсоедините USB-кабель)",
            bg=self.STATUS_BG_IDLE, fg=self.STATUS_FG_IDLE,
            font=(self.FONT_FAMILY, 9, "bold"), padx=12, pady=6
        )
        self.usb_status_label.pack(side="left", fill="x", expand=True)

        # Кнопка Сохранить отчёт (справа)
        self.usb_save_btn = tk.Button(
            ctrl_inner, text="Сохранить отчёт…", command=self.save_usb_report,
            padx=16, pady=7, font=(self.FONT_FAMILY, 9, "bold"), state="disabled"
        )
        self.style_button(
            self.usb_save_btn,
            bg=self.GRAY_BTN, hover_bg=self.GRAY_BTN_HOVER, fg=self.GRAY_BTN_FG
        )
        self.usb_save_btn.pack(side="right", padx=(10, 0))

        # 2. Карточка затвора и диагностики
        self.usb_result_card = tk.Frame(page, bg=self.CARD, highlightbackground=self.BORDER, highlightthickness=1, bd=0)
        self.usb_result_card.pack(fill="x", pady=(0, 8))

        # Заголовок карточки
        tk.Label(
            self.usb_result_card, text="ПОКАЗАНИЯ ДИАГНОСТИЧЕСКИХ СЧЁТЧИКОВ",
            bg=self.CARD, fg=self.MUTED, font=(self.FONT_FAMILY, 9, "bold")
        ).pack(pady=(10, 2))

        # Ряд: крупный механический счётчик + человечный бейдж ресурса
        val_row = tk.Frame(self.usb_result_card, bg=self.CARD)
        val_row.pack(anchor="center", pady=(1, 4))

        self.usb_shutter_label = tk.Label(
            val_row, text="—", bg=self.CARD, fg=self.TEXT,
            font=(self.FONT_FAMILY, 40, "bold")
        )
        self.usb_shutter_label.pack(side="left", padx=(0, 14))

        self.usb_wear_badge = tk.Label(
            val_row, text="●  Ожидает подключения", bg=self.STATUS_BG_IDLE, fg=self.STATUS_FG_IDLE,
            font=(self.FONT_FAMILY, 9, "bold"), padx=12, pady=5
        )
        self.usb_wear_badge.pack(side="left", pady=(8, 0))

        # Разделитель
        tk.Frame(self.usb_result_card, bg=self.BORDER, height=1).pack(fill="x", padx=24, pady=(4, 8))

        # 4 колонки: Общий спуск, Электронный затвор, Температура, Аккумулятор
        meta_frame = tk.Frame(self.usb_result_card, bg=self.CARD)
        meta_frame.pack(fill="x", padx=20, pady=(0, 10))
        meta_frame.columnconfigure(0, weight=1)
        meta_frame.columnconfigure(1, weight=1)
        meta_frame.columnconfigure(2, weight=1)
        meta_frame.columnconfigure(3, weight=1)

        self.usb_cols = {}
        for col, (label, key) in enumerate((
            ("ОБЩИЙ СПУСК", "release_total"),
            ("ЭЛЕКТРОННЫЙ ЗАТВОР", "electronic"),
            ("ТЕМПЕРАТУРА", "temp"),
            ("АККУМУЛЯТОР", "battery"),
        )):
            cell = tk.Frame(meta_frame, bg=self.CARD)
            cell.grid(row=0, column=col, sticky="nsew", padx=6)

            tk.Label(
                cell, text=label, bg=self.CARD, fg=self.MUTED,
                font=(self.FONT_FAMILY, 8, "bold")
            ).pack(anchor="center")

            val_lbl = tk.Label(
                cell, text="—", bg=self.CARD, fg=self.TEXT,
                font=(self.FONT_FAMILY, 10, "bold")
            )
            val_lbl.pack(fill="x", pady=(3, 0))
            self.usb_cols[key] = val_lbl

        # 3. Карточка аппаратных ошибок (Error Log)
        self.usb_err_card = tk.Frame(page, bg=self.CARD, highlightbackground=self.BORDER, highlightthickness=1, bd=0)
        self.usb_err_card.pack(fill="x")

        err_inner = tk.Frame(self.usb_err_card, bg=self.CARD)
        err_inner.pack(fill="x", padx=16, pady=8)

        tk.Label(
            err_inner, text="ЖУРНАЛ АППАРАТНЫХ ОШИБОК (ERROR LOG)",
            bg=self.CARD, fg=self.MUTED, font=(self.FONT_FAMILY, 8, "bold")
        ).pack(anchor="w", pady=(0, 3))

        # Горизонтальная статусная строка ошибок
        self.usb_err_status = tk.Label(
            err_inner, text="●  Камера не опрошена",
            bg=self.CARD, fg=self.MUTED, font=(self.FONT_FAMILY, 9), anchor="w"
        )
        self.usb_err_status.pack(fill="x", pady=(1, 2))

        self.usb_err_note = tk.Label(
            err_inner, text="Готово к онлайн-диагностике камеры.",
            bg=self.CARD, fg=self.SUBTLE, font=(self.FONT_FAMILY, 8), anchor="w"
        )
        self.usb_err_note.pack(fill="x")

    def toggle_usb_connect(self) -> None:
        if self.usb_connected:
            self.disconnect_usb()
        else:
            self.connect_usb()

    def connect_usb(self) -> None:
        self.usb_status_label.config(
            text="⏳  Поиск и опрос камеры по USB… (включите камеру)",
            bg=self.ACCENT_BG, fg=self.ACCENT
        )
        self.usb_connect_btn.config(state="disabled")
        self.root.update_idletasks()

        def _connect_worker():
            try:
                data = self.ptp_mgr.connect()
                self.root.after(0, self._on_connect_success, data)
            except Exception as exc:
                err_msg = str(exc).strip()
                self.root.after(0, self._on_connect_error, err_msg)

        threading.Thread(target=_connect_worker, daemon=True).start()

    def _on_connect_success(self, data: dict) -> None:
        self.usb_connected = True
        self.usb_data = data

        # Активируем кнопку чтения PTP-счётчиков
        self.usb_read_counters_btn.config(state="normal")

        # Обновление кнопки подключения -> Отключить
        self.usb_connect_btn.config(text="Отключить", state="normal")
        self.style_button(
            self.usb_connect_btn,
            bg=self.GRAY_BTN, hover_bg=self.RED_BTN_HOVER, fg=self.GRAY_BTN_FG
        )

        # Статус подключения с серийником и прошивкой
        self.usb_status_label.config(
            text=f"●  Подключено: {data['model']} (№ {data['serial']} · FW v{data['firmware']})",
            bg=self.STATUS_BG_OK, fg=self.STATUS_FG_OK
        )

        # Крупный механический счетчик и бейдж ресурса
        shutter_val = data.get("shutter_mechanical")
        rating_formatted = f"{data['rating']:,}".replace(",", " ")
        if shutter_val is not None:
            shutter_formatted = f"{shutter_val:,}".replace(",", " ")
            wear_val = data.get("wear_percent")
            wear_str = f"{wear_val}%" if wear_val is not None else "—"
            badge_text = f"Использовано ресурса: {wear_str} (из {rating_formatted})"
            badge_bg = self.STATUS_BG_OK
            badge_fg = self.STATUS_FG_OK
        else:
            shutter_formatted = "—"
            badge_text = f"Паспортный ресурс: {rating_formatted}"
            badge_bg = self.STATUS_BG_IDLE
            badge_fg = self.STATUS_FG_IDLE

        self.usb_shutter_label.config(text=shutter_formatted)
        self.usb_wear_badge.config(text=badge_text, bg=badge_bg, fg=badge_fg)

        # 4 колонки
        rel_val = data.get("release_total")
        rel_formatted = f"{rel_val:,}".replace(",", " ") if rel_val is not None else "—"
        self.usb_cols["release_total"].config(text=rel_formatted)

        elec_val = data.get("electronic_shots")
        if elec_val is not None:
            elec_formatted = f"{elec_val:,} ({data.get('electronic_pct', 0)}%)".replace(",", " ")
        else:
            elec_formatted = "—"
        self.usb_cols["electronic"].config(text=elec_formatted)

        # Температура сенсора и платы
        t_img = data.get("temp_imager")
        t_pcb = data.get("temp_pcb")
        if t_img is not None and t_pcb is not None:
            temp_str = f"Сенсор: {t_img} °C  ·  Плата: {t_pcb} °C"
        elif t_img is not None:
            temp_str = f"Сенсор: {t_img} °C"
        elif t_pcb is not None:
            temp_str = f"Плата: {t_pcb} °C"
        else:
            temp_str = "—"
        self.usb_cols["temp"].config(text=temp_str)

        # Аккумулятор с цветной индикацией
        bat_pct = data.get("battery_percent")
        if bat_pct is not None and bat_pct >= 0:
            if bat_pct >= 50:
                bat_icon = "🟢"
                bat_fg = "#16845B" if self.theme_name == "light" else "#34D399"
            elif bat_pct >= 20:
                bat_icon = "🟡"
                bat_fg = "#D97706" if self.theme_name == "light" else "#FBBF24"
            else:
                bat_icon = "🔴"
                bat_fg = "#DC2626" if self.theme_name == "light" else "#F87171"
            self.usb_cols["battery"].config(text=f"{bat_icon}  {bat_pct}%", fg=bat_fg)
        else:
            self.usb_cols["battery"].config(text="—", fg=self.TEXT)

        # Горизонтальная строка ошибок
        if not data.get("errors"):
            self.usb_err_status.config(
                text="●  Аппаратных ошибок нет (чистый сервисный журнал)",
                fg=self.STATUS_FG_OK
            )
        else:
            err_summary = ", ".join(f"{e['code']} ({e['name']})" for e in data["errors"])
            self.usb_err_status.config(
                text=f"●  Зафиксированы инциденты: {err_summary}",
                fg=self.STATUS_FG_WARN
            )

        # Наработка и число включений
        pwr_val = data.get("power_on_count")
        run_tm = data.get("running_time")
        note_parts = ["Затвор исправен (Err 20 / 30 = 0)"]
        if pwr_val is not None:
            note_parts.append(f"Включений: {pwr_val:,}".replace(",", " "))
        if run_tm:
            note_parts.append(f"Наработка: {run_tm}")
        self.usb_err_note.config(text="  ·  ".join(note_parts), fg=self.MUTED)

        # Активируем кнопку сохранения отчёта
        self.usb_save_btn.config(state="normal")

    def _on_connect_error(self, err_msg: str) -> None:
        self.disconnect_usb(keep_status=True)
        self.usb_status_label.config(
            text=f"✕  {err_msg}",
            bg=self.STATUS_BG_ERR, fg=self.STATUS_FG_ERR
        )

    def disconnect_usb(self, keep_status: bool = False) -> None:
        self.ptp_mgr.disconnect()
        self.usb_connected = False
        self.usb_data = None

        self.usb_connect_btn.config(text="Подключить", state="normal")
        self.style_button(
            self.usb_connect_btn,
            bg="#16845B", hover_bg="#13734F", fg="#FFFFFF"
        )

        if not keep_status:
            self.usb_status_label.config(
                text="●  Камера безопасно отключена (кабель можно извлечь)",
                bg=self.STATUS_BG_IDLE, fg=self.STATUS_FG_IDLE
            )

        self.usb_shutter_label.config(text="—")
        self.usb_wear_badge.config(
            text="●  Ожидает подключения",
            bg=self.STATUS_BG_IDLE, fg=self.STATUS_FG_IDLE
        )
        self.usb_cols["release_total"].config(text="—")
        self.usb_cols["electronic"].config(text="—")
        self.usb_cols["temp"].config(text="—")
        self.usb_cols["battery"].config(text="—", fg=self.TEXT)

        self.usb_err_status.config(
            text="●  Камера не опрошена",
            fg=self.MUTED
        )
        self.usb_err_note.config(text="Готово к онлайн-диагностике камеры.", fg=self.SUBTLE)
        self.usb_save_btn.config(state="disabled")

        # Сброс кнопки чтения PTP
        self.usb_read_counters_btn.config(state="disabled", text="Прочитать счётчики")

    def read_usb_counters(self) -> None:
        if not self.usb_connected:
            messagebox.showinfo("OpenEOS Service", "Сначала подключите камеру кнопкой «Подключить».")
            return

        self.usb_read_counters_btn.config(state="disabled", text="⏳ Чтение…")
        self.usb_status_label.config(
            text="⏳  Опрос физической камеры по PTP (0x12000001, 0x12000003)…",
            bg=self.ACCENT_BG, fg=self.ACCENT
        )
        self.root.update_idletasks()

        def _worker():
            try:
                res_dict = self.ptp_mgr.read_live_ptp_properties()
                self.root.after(0, self._on_counters_read_complete, res_dict)
            except Exception as exc:
                err_str = str(exc).strip()
                self.root.after(0, self._on_counters_read_error, err_str)

        threading.Thread(target=_worker, daemon=True).start()

    def _on_counters_read_complete(self, res_dict: dict) -> None:
        self.usb_read_counters_btn.config(state="normal", text="Прочитать счётчики")

        c1 = res_dict.get("counter_0x12000001")
        if c1 is not None:
            self.usb_shutter_label.config(text=f"{c1:,}".replace(",", " "))
            rating = (self.usb_data.get("rating", 0) if self.usb_data else 0) or 100000
            wear_val = round((c1 / rating) * 100, 1)
            rating_formatted = f"{rating:,}".replace(",", " ")
            self.usb_wear_badge.config(
                text=f"Использовано ресурса: {wear_val}% (из {rating_formatted})",
                bg=self.STATUS_BG_OK, fg=self.STATUS_FG_OK
            )

        c3 = res_dict.get("counter_0x12000003")
        if c3 is not None:
            self.usb_cols["release_total"].config(text=f"{c3:,}".replace(",", " "))

        if c1 is not None and c3 is not None and c3 >= c1:
            elec_shots = c3 - c1
            elec_pct = round((elec_shots / c3) * 100, 1) if c3 > 0 else 0
            self.usb_cols["electronic"].config(text=f"{elec_shots:,} ({elec_pct}%)".replace(",", " "))

        pwr_val = res_dict.get("power_on_count")
        uptime_val = res_dict.get("uptime_seconds")
        if pwr_val is not None or uptime_val is not None:
            note_parts = ["Затвор исправен (Err 20 / 30 = 0)"]
            if pwr_val is not None:
                note_parts.append(f"Включений: {pwr_val:,}".replace(",", " "))
            if uptime_val is not None:
                d = uptime_val // 86400
                h = (uptime_val % 86400) // 3600
                m = (uptime_val % 3600) // 60
                s = uptime_val % 60
                note_parts.append(f"Наработка: {d}д {h:02d}ч {m:02d}м {s:02d}с")
            self.usb_err_note.config(text="  ·  ".join(note_parts), fg=self.MUTED)

        # Статусное сообщение в основной строке статуса
        st_overall = res_dict.get("status", "UNKNOWN")
        err_msg = res_dict.get("error_message")
        cur_time = time.strftime("%H:%M:%S")

        if st_overall == "SUCCESS":
            if c1 is not None or c3 is not None:
                c1_txt = f"{c1:,}".replace(",", " ") if c1 is not None else "—"
                c3_txt = f"{c3:,}".replace(",", " ") if c3 is not None else "—"
                self.usb_status_label.config(
                    text=f"●  [{cur_time}] Счётчики прочитаны (Механический: {c1_txt} · Общий: {c3_txt})",
                    bg=self.STATUS_BG_OK, fg=self.STATUS_FG_OK
                )
            else:
                self.usb_status_label.config(
                    text=f"●  [{cur_time}] WPD MTP PTP-обмен: УСПЕХ (0x2001 OK)",
                    bg=self.STATUS_BG_OK, fg=self.STATUS_FG_OK
                )
        elif st_overall == "PARTIAL_SUCCESS":
            self.usb_status_label.config(
                text=f"●  [{cur_time}] Частичный отклик: {err_msg or ''}",
                bg=self.STATUS_BG_WARN, fg=self.STATUS_FG_WARN
            )
        elif st_overall == "UNSUPPORTED":
            self.usb_status_label.config(
                text=f"●  [{cur_time}] Камера отклонила операцию 0x9052 (свойства не поддерживаются)",
                bg=self.STATUS_BG_WARN, fg=self.STATUS_FG_WARN
            )
        else:
            self.usb_status_label.config(
                text=f"✕  [{cur_time}] {err_msg or 'Сбой при чтении PTP-свойств камеры.'}",
                bg=self.STATUS_BG_ERR, fg=self.STATUS_FG_ERR
            )

    def _on_counters_read_error(self, err_str: str) -> None:
        self.usb_read_counters_btn.config(state="normal", text="Прочитать счётчики")
        cur_time = time.strftime("%H:%M:%S")
        self.usb_status_label.config(
            text=f"✕  [{cur_time}] Ошибка опроса камеры: {err_str}",
            bg=self.STATUS_BG_ERR, fg=self.STATUS_FG_ERR
        )

    def save_usb_report(self) -> None:
        if not self.usb_connected or not self.usb_data:
            messagebox.showinfo("OpenEOS Service", "Сначала подключите камеру для формирования отчёта.")
            return

        report_text = self.ptp_mgr.export_report_text()
        default_name = f"Diagnostic_{self.usb_data['model'].replace(' ', '_')}_{self.usb_data['serial']}.txt"

        path = filedialog.asksaveasfilename(
            title="Сохранить отчёт диагностики",
            initialfile=default_name,
            defaultextension=".txt",
            filetypes=[("Текстовый отчёт", "*.txt"), ("Все файлы", "*.*")]
        )
        if not path:
            return

        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(report_text)
            messagebox.showinfo("OpenEOS Service", f"Отчёт успешно сохранён:\n{path}")
        except Exception as exc:
            messagebox.showerror("OpenEOS Service", f"Не удалось сохранить файл:\n{str(exc)}")

    # ---------------------------------------------------------------------------
    # Вкладка 1: Проверить фото (Single file)
    # ---------------------------------------------------------------------------
    def create_single_tab(self) -> None:
        page = tk.Frame(self.single_tab, bg=self.BG)

@echo off
setlocal EnableExtensions
cd /d "%~dp0"

set "PROJECT=%USERPROFILE%\OpenEOS"
set "PYTHON=%PROJECT%\build-env\Scripts\python.exe"
set "EXIFTOOL_DIR=C:\Tools\ExifTool"
set "SOURCE=%PROJECT%\openeos_service.py"
set "OUTPUT=%PROJECT%\dist\OpenEOS_Service.exe"

echo ============================================================
echo      OpenEOS Service - Fully Autonomous Standalone Build
echo ============================================================
echo.

if not exist "%PYTHON%" (
    echo ERROR: Python build-env was not found.
    pause
    exit /b 1
)

echo [1/3] Preparing camera icons and local Canon SDK binaries...
"%PYTHON%" "%PROJECT%\create_icons.py"
"%PYTHON%" "%PROJECT%\copy_local_edsdk.py"

echo.
echo [2/3] Compiling native Canon USB engine (canon_live_usb.exe)...
if exist "%SystemRoot%\Microsoft.NET\Framework\v4.0.30319\csc.exe" (
    "%SystemRoot%\Microsoft.NET\Framework\v4.0.30319\csc.exe" /nologo /platform:x86 /optimize+ /target:exe /out:"%PROJECT%\canon_live_usb.exe" "%PROJECT%\canon_live_usb.cs"
)

echo.
echo [3/3] Building standalone 100%% autonomous OpenEOS_Service.exe...
"%PYTHON%" -m PyInstaller ^
 --noconfirm ^
 --clean ^
 --onefile ^
 --windowed ^
 --noupx ^
 --name OpenEOS_Service ^
 --icon "%PROJECT%\app_icon_service.ico" ^
 --distpath "%PROJECT%\dist" ^
 --workpath "%PROJECT%\build" ^
 --specpath "%PROJECT%\build_spec" ^
 --add-binary "%EXIFTOOL_DIR%\exiftool.exe;." ^
 --add-data "%EXIFTOOL_DIR%\exiftool_files;exiftool_files" ^
 --add-data "%PROJECT%\app_icon_service.png;." ^
 --add-data "%PROJECT%\app_icon_service.ico;." ^
 --add-binary "%PROJECT%\canon_live_usb.exe;." ^
 --add-binary "%PROJECT%\EDSDK.dll;." ^
 --add-binary "%PROJECT%\EdsImage.dll;." ^
 --collect-all tkinterdnd2 ^
 --hidden-import tkinterdnd2 ^
 "%SOURCE%"

if errorlevel 1 (
    echo.
    echo ERROR: Build failed!
    pause
    exit /b 1
)

echo.
echo ============================================================
echo AUTONOMOUS BUILD SUCCESSFUL: %OUTPUT%
echo This file contains all Canon SDK libraries and runs on ANY PC!
echo ============================================================
echo.
start "" "%PROJECT%\dist"
pause
exit /b 0

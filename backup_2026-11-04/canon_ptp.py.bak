"""
OpenEOS Service: Core Canon USB Hardware Engine.
Direct Live Hardware Communication via Official Canon EDSDK & Win32 SetupAPI.
Zero mock data. Zero disk/dump reading. 100% online hardware polling on every click.
"""
from __future__ import annotations

import ctypes
from ctypes import wintypes
import json
import os
from pathlib import Path
import struct
import subprocess
import sys
import time

def dbg_log(msg: str):
    try:
        log_path = Path(__file__).parent / "sti_debug.log"
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")
    except Exception:
        pass

# Диагностика экспортов EDSDK.dll
try:
    _d = Path(__file__).parent / "EDSDK.dll"
    if _d.exists():
        import dump_exports
        _exps = dump_exports.dump_pe_exports(_d)
        _interesting = [e for e in _exps if any(k in e.lower() for k in ["command", "ptp", "prop", "vendor", "custom", "send", "get"])]
        Path(__file__).parent.joinpath("edsdk_commands.txt").write_text("\n".join(_interesting), encoding="utf-8")
except Exception:
    pass

try:
    import fetch_src
except Exception as _ex:
    dbg_log(f"fetch_src error: {_ex}")

def read_shutter_from_header(file_path: str) -> int | None:
    if not file_path or not os.path.isfile(file_path):
        return None
    try:
        exiftool_exe = r"C:\Tools\ExifTool\exiftool.exe"
        if not os.path.isfile(exiftool_exe):
            exiftool_exe = "exiftool"
        creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        res = subprocess.run(
            [exiftool_exe, "-Track4:ShutterCount", "-Canon:ShutterCount", "-ShutterCount", "-s3", "-fast2", file_path],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            creationflags=creationflags,
            timeout=3
        )
        out = res.stdout.strip()
        import re
        m = re.search(r"(\d+)", out)
        if m:
            val = int(m.group(1))
            dbg_log(f"Extracted ShutterCount from downloaded camera header: {val}")
            return val
    except Exception as ex:
        dbg_log(f"ExifTool header parse error: {ex}")
    return None

